{
  "name": "cpp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": "./src/*"
  },
  "dependencies": {
    "modern-tar": "^0.8.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@rsbuild/core": "^2.2.5"
  },
  "scripts": {
    "fetch-assets": "node scripts/fetch-assets.mjs",
    "dev": "npm run fetch-assets && rsbuild",
    "build": "tsc -b && tsc -b tsconfig.test.json",
    "preview": "npm run fetch-assets && rsbuild build && rsbuild preview --port 3002",
    "test": "tsc -b && tsc -b tsconfig.test.json && vitest run tests",
    "test:e2e": "npm run fetch-assets && tsc -b tsconfig.test.json && playwright test",
    "clean": "tsc -b --clean"
  }
}
