{
  "name": "cpp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": "./src/*"
  },
  "devDependencies": {
    "core": "*"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -b tsconfig.test.json && vite build",
    "preview": "vite preview",
    "test": "tsc -b && tsc -b tsconfig.test.json && vitest run --config vitest.config.ts && vitest run --config vitest.e2e.config.ts",
    "test:unit": "tsc -b && tsc -b tsconfig.test.json && vitest run --config vitest.config.ts tests/unit",
    "test:manual": "MANUAL=1 vitest run --config vitest.e2e.config.ts e2e/diagramProfile.manual.spec.ts",
    "test:profile": "MANUAL=1 vitest run --config vitest.e2e.config.ts e2e/diagramProfile.manual.spec.ts",
    "clean": "tsc -b --clean",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  }
}
