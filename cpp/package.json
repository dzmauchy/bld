{
  "name": "cpp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": "./src/*"
  },
  "dependencies": {
    "modern-tar": "^0.8.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@rsbuild/core": "^2.2.5",
    "@rstest/adapter-rsbuild": "^0.12.2",
    "core": "*"
  },
  "scripts": {
    "dev": "rsbuild",
    "build": "tsc -b && tsc -b tsconfig.test.json",
    "preview": "rsbuild build && rsbuild preview --port 3002",
    "test": "tsc -b && tsc -b tsconfig.test.json && rstest tests && playwright test",
    "test:unit": "tsc -b && tsc -b tsconfig.test.json && rstest tests/unit",
    "clean": "tsc -b --clean"
  }
}
