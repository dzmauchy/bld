{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "lib": [
      "ES2025",
      "DOM",
      "DOM.AsyncIterable",
      "DOM.Iterable"
    ],
    "allowImportingTsExtensions": true,
    "types": [
      "vite/client"
    ],
    "rootDir": ".",
    "outDir": "./dist"
  },
  "include": [
    "./src"
  ],
  "references": [
    {
      "path": "../core"
    }
  ]
}
