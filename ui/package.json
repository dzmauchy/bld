{
  "name": "ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "exports": {
    "./*": "./src/*"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b tsconfig.json tsconfig.test.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run && npm run test:e2e",
    "test:unit": "vitest run tests/unit",
    "clean": "tsc -b --clean",
    "deploy": "wrangler deploy --config ../wrangler.json",
    "test:e2e": "vitest run -c vitest.e2e.config.ts"
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.14.0",
    "@maxgraph/core": "^0.25.0",
    "core": "*",
    "cpp": "*",
    "lit": "^3.3.3",
    "@lit-labs/signals": "^0.3.0"
  }
}
