{
  "name": "ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite",
    "assets": "node scripts/fetch-base-release.mjs",
    "prebuild": "npm run assets",
    "predev": "npm run assets",
    "pretest": "npm run assets",
    "build": "tsc -b && tsc -b tsconfig.test.json && vite build",
    "preview": "vite preview",
    "test": "tsc -b && tsc -b tsconfig.test.json && vitest run --config vitest.config.ts && vitest run --config vitest.e2e.config.ts",
    "test:unit": "tsc -b && tsc -b tsconfig.test.json && vitest run --config vitest.config.ts tests/unit",
    "clean": "tsc -b --clean",
    "deploy": "wrangler deploy --config ../wrangler.json",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.14.0",
    "@maxgraph/core": "^0.25.0",
    "core": "*",
    "modern-tar": "^0.8.5",
    "cpp": "*",
    "lit": "^3.3.3",
    "@lit-labs/signals": "^0.3.0"
  }
}
