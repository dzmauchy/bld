  "scripts": {
    "dev": "rsbuild",
    "build": "tsc -b && tsc -b tsconfig.test.json && rsbuild build",
    "preview": "rsbuild preview",
    "test": "tsc -b && tsc -b tsconfig.test.json && vitest run tests && playwright test",
