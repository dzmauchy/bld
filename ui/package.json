{
  "name": "ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "rsbuild",
    "assets": "node scripts/fetch-base-release.mjs",
    "prebuild": "npm run assets",
    "predev": "npm run assets",
    "pretest": "npm run assets",
    "build": "tsc -b && tsc -b tsconfig.test.json && rsbuild build",
    "preview": "rsbuild preview",
    "test": "tsc -b && tsc -b tsconfig.test.json && rstest tests && playwright test",
    "test:unit": "tsc -b && tsc -b tsconfig.test.json && rstest tests/unit",
    "clean": "tsc -b --clean",
    "deploy": "wrangler deploy --config ../wrangler.json"
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.14.0",
    "@joint/router-avoid": "^4.3.3",
    "@solidjs/web": "^2.0.0-rc.13",
    "core": "*",
    "modern-tar": "^0.8.5",
    "cpp": "*",
    "solid-js": "^2.0.0-rc.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@rsbuild/core": "^2.2.12",
    "@rsbuild/plugin-solid": "2.0.0-rc.1",
    "@rstest/adapter-rsbuild": "^0.12.3",
    "@solidjs/compiler": "2.0.0-rc.13"
  }
}
