    "runtime": "*",
    "solid-js": "^2.0.0-rc.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@rsbuild/core": "^2.2.9",
    "@rsbuild/plugin-solid": "^2.0.0-rc.0",
    "@solidjs/compiler": "2.0.0-rc.9",
    "base": "*"
  }
}
