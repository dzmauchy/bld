{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bld.d-ovchinnikow.workers.dev/schemas/namespaces.schema.json",
  "title": "Namespace Hierarchy Schema",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" }
  },
  "additionalProperties": {
    "$ref": "#/$defs/Namespace"
  },
  "$defs": {
    "Namespace": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "icon": { "type": "string" },
        "description": { "type": "string" },
        "children": { "$ref": "#" }
      },
      "additionalProperties": false
    }
  }
}