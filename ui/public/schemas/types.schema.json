{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bld.d-ovchinnikow.workers.dev/schemas/types.schema.json",
  "title": "TypeRegistry",
  "description": "Schema for a registry of primitive and generic types with compatibility and parameter definitions.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Path or URI to the JSON schema."
    }
  },
  "patternProperties": {
    "^[a-zA-Z_][a-zA-Z0-9_-]*$": {
      "$ref": "#/$defs/typeDefinition"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "typeDefinition": {
      "type": "object",
      "required": [
        "name",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Display name of the type."
        },
        "description": {
          "type": "string",
          "description": "Detailed explanation of the type's purpose and range."
        },
        "as_arg_compatible_with": {
          "type": "array",
          "description": "List of type identifiers that can be coerced or accepted as an argument for this type.",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "params": {
          "type": "object",
          "description": "Generic type parameters for parameterized types.",
          "patternProperties": {
            "^[a-zA-Z_][a-zA-Z0-9_-]*$": {
              "$ref": "#/$defs/typeParameter"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "typeParameter": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Display name or label for the type parameter."
        },
        "description": {
          "type": "string",
          "description": "Optional description for the type parameter."
        }
      },
      "additionalProperties": false
    }
  }
}