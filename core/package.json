{
  "name": "core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./wasm": "./src/wasm/index.ts",
    "./assets/*": "./assets/*",
    "./*": "./src/*"
  },
  "dependencies": {
    "runtime": "*",
    "base": "*"
  },
  "scripts": {
    "build": "tsc -b && tsc -b tsconfig.test.json",
    "test": "tsc -b && tsc -b tsconfig.test.json && vitest run tests",
    "test:e2e": "tsc -b && tsc -b tsconfig.test.json && vitest run e2e",
    "clean": "tsc -b --clean"
  }
}
