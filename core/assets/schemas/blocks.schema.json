{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bld.d-ovchinnikow.workers.dev/schemas/blocks.schema.json",
  "title": "Blocks Schema",
  "description": "Schema definition for DSP / stream processing block catalog entries.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    }
  },
  "additionalProperties": {
    "$ref": "#/$defs/block"
  },
  "$defs": {
    "block": {
      "type": "object",
      "required": ["ns", "icon", "title", "description"],
      "properties": {
        "ns": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Hierarchical namespace path for the block."
        },
        "icon": {
          "type": "string",
          "description": "Icon asset identifier or filename."
        },
        "title": {
          "type": "string",
          "description": "Human-readable name of the block."
        },
        "description": {
          "type": "string",
          "description": "Detailed explanation of block functionality."
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/port"
          },
          "description": "Named input ports."
        },
        "outputs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/port"
          },
          "description": "Named output ports."
        },
        "conf": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/confItem"
          },
          "description": "Configurable parameters for the block."
        },
        "implementation": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Implementation notes, contracts, or generation specifications."
        }
      },
      "additionalProperties": false
    },
    "port": {
      "type": "object",
      "required": ["vector", "type"],
      "properties": {
        "vector": {
          "type": "boolean",
          "description": "Indicates whether the port supports vectorized streams."
        },
        "type": {
          "$ref": "#/$defs/typeDef"
        },
        "concept": {
          "$ref": "#/$defs/concept"
        }
      },
      "additionalProperties": false
    },
    "typeDef": {
      "type": "object",
      "required": ["raw"],
      "properties": {
        "raw": {
          "type": "string",
          "description": "Primitive or generic base type (e.g. f32, u32, u8, array, pss)."
        },
        "args": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/typeDef"
          },
          "description": "Generic type parameters (e.g. T)."
        }
      },
      "additionalProperties": false
    },
    "concept": {
      "type": "object",
      "properties": {
        "length": {
          "$ref": "#/$defs/lengthRule"
        },
        "args": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "vector": { "type": "boolean" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": false
    },
    "confItem": {
      "type": "object",
      "required": ["type", "control"],
      "properties": {
        "type": {
          "$ref": "#/$defs/typeDef"
        },
        "control": {
          "$ref": "#/$defs/control"
        }
      },
      "additionalProperties": false
    },
    "control": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "description": "Widget/control kind (e.g., slider, spinner, set_of_pins, text_input)."
        },
        "default": {
          "description": "Initial control value."
        },
        "min": {
          "type": "number",
          "description": "Minimum acceptable value."
        },
        "max": {
          "type": "number",
          "description": "Maximum acceptable value."
        },
        "step": {
          "type": "number",
          "description": "Step interval for numeric controls."
        },
        "unit": {
          "type": "string",
          "description": "Measurement unit display (e.g., 's', 'ms')."
        },
        "format": {
          "type": "string",
          "description": "Expected data format or validation mask."
        },
        "length": {
          "$ref": "#/$defs/lengthRule"
        },
        "args": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/control"
          },
          "description": "Nested element control definitions."
        },
        "implementation": {
          "type": "array",
          "items": { "type": "string" },
          "description": "UI/UX interaction behaviors and validation requirements."
        }
      },
      "additionalProperties": true
    },
    "lengthRule": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "description": "Constraint relationship (e.g., eq, lte, gte)."
        },
        "bind": {
          "$ref": "#/$defs/binding"
        }
      },
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["conf", "input", "output"],
          "description": "Target component space to bind against."
        },
        "id": {
          "type": "string",
          "description": "Identifier of the target parameter or port."
        },
        "control": {
          "type": "object",
          "properties": {
            "length": {
              "$ref": "#/$defs/lengthRule"
            }
          },
          "additionalProperties": true
        },
        "concept": {
          "type": "object",
          "properties": {
            "length": {
              "$ref": "#/$defs/lengthRule"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  }
}