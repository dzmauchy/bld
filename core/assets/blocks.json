        "vector": true,
        "type": {"raw": "pss", "args": {"T": {"raw": "f32"}}}
      }
    },
    "conf": {
      "precision": {
        "type": {"raw": "u32"},
        "control": {
          "type": "slider",
          "default": 10,
          "min": 1,
          "max": 1000,
          "unit": "ms"
        }
      },
      "frequency": {
        "type": {"raw": "f32"},
        "control": {
          "type": "text_input",
          "default": 1,
          "min": 0.001,
          "max": 100,
          "format": "f32",
          "unit": "Hz"
        }
      },
      "amplitude": {
        "type": {"raw": "f32"},
        "control": {
          "type": "text_input",
          "default": 1,
          "format": "f32"
        }
      },
      "phase": {
        "type": {"raw": "f32"},
        "control": {
          "type": "text_input",
          "default": 0,
          "format": "f32",
          "unit": "Radians"
        }
      }
    }
  },
