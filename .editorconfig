root = true

[*.{xml,js,ts,tsx,json,yaml,yml,css,html}]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = false
max_line_length = 160
tab_width = 2

[*.{ts,tsx}]
ij_typescript_keep_simple_blocks_in_one_line = true
ij_typescript_keep_simple_methods_in_one_line = true
ij_typescript_blank_lines_around_method = 0
ij_typescript_blank_lines_around_method_in_interface = 0
ij_typescript_blank_lines_around_field = 0
ij_typescript_blank_lines_around_field_in_interface = 0
ij_typescript_blank_lines_around_class = 0
ij_typescript_blank_lines_around_function = 0
ij_typescript_blank_lines_after_imports = 1

[*.json]
ij_json_indent_size = 2
ij_json_tab_width = 2
ij_json_array_wrapping = on_every_item
ij_json_object_wrapping = on_every_item

[{*.cmake,CMakeLists.txt}]
ij_cmake_align_command_call_r_par = false
ij_cmake_align_control_flow_r_par = false
ij_cmake_align_multiline_parameters_in_calls = false
ij_cmake_force_commands_case = 2
ij_cmake_keep_blank_lines_in_code = 2
ij_cmake_space_before_for_parentheses = false
ij_cmake_space_before_if_parentheses = false
ij_cmake_space_before_method_call_parentheses = false
ij_cmake_space_before_method_parentheses = false
ij_cmake_space_before_while_parentheses = false
ij_cmake_spaces_within_for_parentheses = false
ij_cmake_spaces_within_if_parentheses = false
ij_cmake_spaces_within_method_call_parentheses = false
ij_cmake_spaces_within_method_parentheses = false
ij_cmake_spaces_within_while_parentheses = false
ij_cmake_indent_size = 2